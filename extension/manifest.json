{
  "manifest_version": 3,
  "name": "Mechano Download Manager Integration",
  "version": "1.3.0",
  "description": "Download button on every video (YouTube, Facebook, Instagram, TikTok, X...) and download takeover for Mechano Download Manager.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Mechano DM", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["overlay.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "permissions": ["downloads", "contextMenus", "cookies", "storage", "webRequest", "tabs"],
  "host_permissions": ["<all_urls>"]
}
